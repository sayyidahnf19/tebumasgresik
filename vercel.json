{
  "buildCommand": "composer install --no-dev && npm install && npm run build && php artisan config:cache && php artisan route:cache",
  "installCommand": "composer install --prefer-dist --no-dev && npm install",
  "outputDirectory": "public",
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "COMPOSER_ALLOW_SUPERUSER": "1"
  },
  "functions": {
    "api/index.php": {
      "runtime": "php-8.2",
      "memory": 1024,
      "timeout": 60
    }
  },
  "routes": [
    {
      "src": "/build/.*",
      "dest": "/build/$1"
    },
    {
      "src": "/storage/.*",
      "dest": "/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}
